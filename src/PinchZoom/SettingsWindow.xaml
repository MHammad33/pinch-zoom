<Window x:Class="PinchZoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinchZoom Settings"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#FAFAFA"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock Text="Zoom key" FontWeight="SemiBold" />
        <TextBlock Text="Hold this key to zoom. Click the box, then press a key."
                   Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,8" />
        <Button x:Name="KeyButton"
                Height="34"
                Padding="10,0"
                HorizontalContentAlignment="Left"
                Background="White"
                Click="OnKeyButtonClick"
                LostKeyboardFocus="OnKeyButtonLostFocus" />
        <TextBlock x:Name="KeyMessage"
                   Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock Text="Zoom level" FontWeight="SemiBold" Margin="0,22,0,0" />
        <DockPanel Margin="0,8,0,0">
            <TextBlock x:Name="ZoomValue"
                       DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="ZoomSlider"
                    Minimum="1.5" Maximum="5"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    SmallChange="0.1" LargeChange="0.5"
                    VerticalAlignment="Center"
                    ValueChanged="OnZoomChanged" />
        </DockPanel>

        <TextBlock x:Name="SaveMessage"
                   Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Save" IsDefault="True" Width="84" Height="30" Click="OnSave" />
            <Button Content="Cancel" IsCancel="True" Width="84" Height="30" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
